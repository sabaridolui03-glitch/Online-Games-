
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Gaming Zone</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #101322;
      color: white;
      text-align: center;
    }
    header {
      padding: 28px 12px;
      background: #6428df;
    }
    .games {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 15px;
      padding: 20px;
    }
    .game {
      background: #202741;
      padding: 22px 10px;
      border-radius: 14px;
    }
    .emoji { font-size: 45px; }
    button {
      background: #20d6a1;
      border: 0;
      padding: 10px 18px;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
    }
    footer { padding: 20px; color: #bbb; }
  </style>
</head>
<body>
  <header>
    <h1>🎮 My Gaming Zone</h1>
    <p>Choose a game and have fun!</p>
  </header>

  <h2>🔥 Popular Games</h2>

  <main class="games">
    <div class="game">
      <div class="emoji">🐍</div>
      <h3>Snake Game</h3>
      <button onclick="alert('Snake Game coming soon!')">Play Now</button>
    </div>

    <div class="game">
      <div class="emoji">❌</div>
      <h3>Tic Tac Toe</h3>
      <button onclick="alert('Tic Tac Toe coming soon!')">Play Now</button>
    </div>

    <div class="game">
      <div class="emoji">🏓</div>
      <h3>Pong Game</h3>
      <button onclick="alert('Pong Game coming soon!')">Play Now</button>
    </div>

    <div class="game">
      <div class="emoji">🧩</div>
      <h3>Puzzle Game</h3>
      <button onclick="alert('Puzzle Game coming soon!')">Play Now</button>
    </div>
  </main>

  <footer>© 2026 My Gaming Zone</footer>
</body>
</html>
